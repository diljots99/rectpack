{
  "name": "rectpackbin",
  "version": "0.0.10",
  "description": "Rectangle bin packing for JavaScript (MaxRects, Skyline and Guillotine), ported from the Python rectpack library.",
  "keywords": [
    "bin-packing",
    "rectangle-packing",
    "rectpack",
    "maxrects",
    "skyline",
    "guillotine"
  ],
  "homepage": "https://www.diljotsingh.com",
  "bugs": {
    "url": "https://github.com/diljots99/rectpack/issues"
  },
  "main": "src/index.js",
  "module": "commonjs",
  "scripts": {
    "test:single": "jest -t default_options test/packer/packer.test.js",
    "test": "jest test/waste/waste.test.js",
    "build": "npx esbuild index.js --bundle --minify --platform=browser --outfile=dist/rectpackbin.min.js"

  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diljots99/rectpack.git"
  },
  "author": {
    "name": "Diljot Singh",
    "url": "https://www.diljotsingh.com"
  },
  "license": "MIT",
  "dependencies": {
    "canvas": "^3.1.0",
    "guillotine-packer": "^1.0.2",
    "sharp": "^0.34.1"
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "jest": "^29.7.0"
  }
}
